@using NewTube.Shared.DataTransfer
@using NewTube.Shared.Interfaces
@inherits FragmentBase
@rendermode InteractiveWebAssembly

@inject IAuthenticationService _authService

<TableWrapper> 
    <LabeledInputTableRow label="User Name:" type="text" placeholder="user name" @bind-value="loginRequest.UserName"/>
    <LabeledInputTableRow label="Password:" type="password" placeholder="password" @bind-value="loginRequest.Password"/>
    <TableFormFooter>
        <button @onclick="loginUser">login</button>
        @ChildContent
    </TableFormFooter>
</TableWrapper>

@code {
    private LoginRequest loginRequest = new LoginRequest();

    private async void loginUser() {
        var response = await _authService.LoginUserAsync(loginRequest);
        Console.WriteLine("thing");
    }
}


