@rendermode InteractiveWebAssembly

@using NewTube.Shared.DataTransfer
@using NewTube.Shared.Interfaces

@inject IAuthenticationService _authService
@inject NavigationManager _navigationManager

<TableWrapper>
    <LabeledInputTableRow label="Email Address:" type="email"/>
    <LabeledInputTableRow label="User Name:" type="text" @bind-value="signUpRequest.UserName"/>
    <LabeledInputTableRow label="Password:" type="password" @bind-value="signUpRequest.PassWord"/>
    <LabeledInputTableRow label="Confirm Password:" type="password" />
    <TableFormFooter>
        - I certify I am over 13 years old
        <br />
        <button @onclick="Submit" @onclick:preventDefault>Sign up</button>
    </TableFormFooter>
</TableWrapper>

@code {
    private SignUpRequest signUpRequest { get; set; } = new SignUpRequest();
    private async void Submit() {
        SignUpResponse result = await _authService.RegisterUserAsync(signUpRequest);
        _navigationManager.NavigateTo("/");
    }
}